    async def async_determineInverterType(self, hub, config):
        # ... (stejné jako v předchozí verzi) ...
        _LOGGER.info("Sunway Plugin: Assuming fixed inverter type.")
        try:
             res = await hub.async_read_holding_registers(unit=hub._modbus_addr, address=10000, count=8)
             if res and not res.isError() and hasattr(res, 'registers'):
                 decoder = BinaryPayloadDecoder.fromRegisters(res.registers, byteorder=self.order16, wordorder=self.order32)
                 sn = decoder.decode_string(16).rstrip(b'\x00').decode('utf-8', errors='ignore')
                 if hasattr(hub,'seriesnumber'): hub.seriesnumber = sn
                 hub.data['inverter_sn'] = sn
                 _LOGGER.info(f"Sunway Plugin: Read serial number: {sn}")
             else:
                 _LOGGER.warning(f"Sunway Plugin: Failed to read serial number during init: {res}")
        except Exception as e:
            _LOGGER.warning(f"Sunway Plugin: Error reading serial number during init: {e}", exc_info=True)
        return 1

